<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#000000">
<title>CodeChat - Home</title>

<script src="https://unpkg.com/lucide@latest"></script>

<style>
    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI",
                     Roboto, Helvetica, Arial, sans-serif;
    }

    body {
        background: #000;
        color: #fff;
        min-height: 100vh;
        padding-bottom: 70px;
    }

    .feed-container {
        width: 100%;
        max-width: 600px;
        min-height: 100vh;
        margin: auto;
        background: #000;
        border-left: 1px solid #1f1f1f;
        border-right: 1px solid #1f1f1f;
    }

    /* HEADER */

    .feed-header {
        position: sticky;
        top: 0;
        z-index: 100;
        height: 60px;
        padding: 0 16px;

        display: flex;
        align-items: center;
        justify-content: space-between;

        background: rgba(0, 0, 0, 0.92);
        backdrop-filter: blur(14px);
        border-bottom: 1px solid #1f1f1f;
    }

    .brand {
        font-size: 23px;
        font-weight: 800;
        letter-spacing: -1px;
    }

    .header-btn {
        width: 40px;
        height: 40px;
        border: none;
        background: transparent;
        color: #fff;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        border-radius: 50%;
    }

    .header-btn:active {
        background: #1c1c1c;
    }

    /* FEED */

    #feedBox {
        width: 100%;
    }

    .post-card {
        width: 100%;
        border-bottom: 1px solid #202020;
        padding-bottom: 14px;
    }

    .post-user-row {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 12px 14px;
    }

    .post-avatar {
        width: 38px;
        height: 38px;
        min-width: 38px;
        border-radius: 50%;
        background: #222;

        display: flex;
        align-items: center;
        justify-content: center;

        overflow: hidden;
        font-size: 14px;
        font-weight: 700;
    }

    .post-avatar img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .post-user-info {
        min-width: 0;
        flex: 1;
    }

    .post-username {
        font-size: 14px;
        font-weight: 700;
        color: #fff;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .post-time {
        margin-top: 2px;
        font-size: 12px;
        color: #777;
    }

    /* POST IMAGE */

    .post-main-img {
        display: block;
        width: 100%;
        max-height: 650px;
        object-fit: cover;
        background: #111;
    }

    /* ACTIONS */

    .post-actions {
        display: flex;
        align-items: center;
        gap: 18px;
        padding: 12px 14px 7px;
    }

    .action-btn {
        border: none;
        background: transparent;
        color: #fff;
        padding: 0;
        display: flex;
        align-items: center;
        cursor: pointer;
    }

    .action-btn:active {
        transform: scale(0.9);
    }

    .action-btn.liked {
        color: #ff3040;
    }

    .save-btn {
        margin-left: auto;
    }

    /* POST INFO */

    .post-info-box {
        padding: 0 14px;
    }

    .likes-count {
        font-size: 14px;
        font-weight: 700;
        margin-bottom: 5px;
    }

    .post-caption {
        font-size: 14px;
        line-height: 1.45;
        color: #eee;
        word-break: break-word;
    }

    .caption-username {
        font-weight: 700;
        margin-right: 6px;
        color: #fff;
    }

    /* EMPTY / LOADING */

    .state-box {
        min-height: 350px;
        padding: 40px 20px;

        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;

        text-align: center;
        color: #888;
    }

    .state-box i {
        margin-bottom: 15px;
    }

    .state-title {
        color: #fff;
        font-size: 17px;
        font-weight: 700;
        margin-bottom: 7px;
    }

    .state-text {
        font-size: 14px;
        line-height: 1.5;
    }

    /* BOTTOM NAV */

    .bottom-nav {
        position: fixed;
        bottom: 0;
        left: 50%;
        transform: translateX(-50%);

        width: 100%;
        max-width: 600px;
        height: 64px;

        background: rgba(0, 0, 0, 0.96);
        backdrop-filter: blur(14px);

        border-top: 1px solid #202020;

        display: flex;
        align-items: center;
        justify-content: space-around;

        z-index: 500;
    }

    .nav-icon {
        width: 48px;
        height: 48px;

        display: flex;
        align-items: center;
        justify-content: center;

        color: #aaa;
        text-decoration: none;
        border-radius: 14px;
    }

    .nav-icon.active {
        color: #fff;
    }

    .nav-icon:active {
        background: #171717;
    }

    /* DESKTOP */

    @media (min-width: 700px) {
        body {
            background: #080808;
        }

        .feed-container {
            min-height: 100vh;
        }
    }
</style>
</head>

<body>

<div class="feed-container">

    <!-- HEADER -->

    <header class="feed-header">

        <div class="brand">
            CodeChat
        </div>

        <button
            class="header-btn"
            onclick="location.href='chats.html'"
            aria-label="Messages"
        >
            <i data-lucide="message-circle"></i>
        </button>

    </header>


    <!-- FEED -->

    <main id="feedBox">

        <div class="state-box">
            <i data-lucide="loader-circle"></i>

            <div class="state-title">
                Loading feed
            </div>

            <div class="state-text">
                Please wait...
            </div>
        </div>

    </main>


    <!-- BOTTOM NAV -->

    <nav class="bottom-nav">

        <a href="feed.html" class="nav-icon active" aria-label="Home">
            <i data-lucide="house"></i>
        </a>

        <a href="search.html" class="nav-icon" aria-label="Discover">
            <i data-lucide="search"></i>
        </a>

        <a href="upload.html" class="nav-icon" aria-label="Create">
            <i data-lucide="plus-square"></i>
        </a>

        <a href="reels.html" class="nav-icon" aria-label="Reels">
            <i data-lucide="clapperboard"></i>
        </a>

        <a href="profile.html" class="nav-icon" aria-label="Profile">
            <i data-lucide="user"></i>
        </a>

    </nav>

</div>


<script type="module">

import {
    initializeApp
} from "https://www.gstatic.com/firebasejs/12.0.0/firebase-app.js";

import {
    getAuth,
    onAuthStateChanged
} from "https://www.gstatic.com/firebasejs/12.0.0/firebase-auth.js";

import {
    getFirestore,
    collection,
    query,
    orderBy,
    onSnapshot
} from "https://www.gstatic.com/firebasejs/12.0.0/firebase-firestore.js";


/* =========================
   FIREBASE
========================= */

const firebaseConfig = {
    apiKey: "AIzaSyDgOaEVjw-L7O83Wj-N7j_XQYO8RuX4sQU",
    authDomain: "code-chat-a82d0.firebaseapp.com",
    projectId: "code-chat-a82d0",
    storageBucket: "code-chat-a82d0.firebasestorage.app",
    messagingSenderId: "863595576976",
    appId: "1:863595576976:web:61217f6961e3e3a5016215"
};

const app = initializeApp(firebaseConfig);

const auth = getAuth(app);
const db = getFirestore(app);

const feedBox = document.getElementById("feedBox");


/* =========================
   ICONS
========================= */

lucide.createIcons();


/* =========================
   AUTH CHECK
========================= */

onAuthStateChanged(auth, (user) => {

    if (!user) {
        window.location.href = "login.html";
        return;
    }

    listenFeed();

});


/* =========================
   FEED LISTENER
========================= */

function listenFeed() {

    const postsQuery = query(
        collection(db, "global_posts"),
        orderBy("timestamp", "desc")
    );

    onSnapshot(
        postsQuery,

        (snapshot) => {

            feedBox.innerHTML = "";

            if (snapshot.empty) {

                showEmptyFeed();

                return;
            }

            snapshot.forEach((docSnap) => {

                const post = docSnap.data();

                const postElement = createPost(
                    docSnap.id,
                    post
                );

                feedBox.appendChild(postElement);

            });

            lucide.createIcons();

        },

        (error) => {

            console.error("Feed error:", error);

            showFeedError();

        }
    );
}


/* =========================
   CREATE POST
========================= */

function createPost(postId, data) {

    const card = document.createElement("article");

    card.className = "post-card";


    /* USER ROW */

    const userRow = document.createElement("div");

    userRow.className = "post-user-row";


    /* AVATAR */

    const avatar = document.createElement("div");

    avatar.className = "post-avatar";


    const username =
        data.username ||
        "user";


    if (data.avatar) {

        const img = document.createElement("img");

        img.src = data.avatar;

        img.alt = username;

        img.loading = "lazy";

        avatar.appendChild(img);

    } else {

        avatar.textContent =
            username
            .charAt(0)
            .toUpperCase();

    }


    /* USER INFO */

    const userInfo = document.createElement("div");

    userInfo.className = "post-user-info";


    const usernameElement =
        document.createElement("div");

    usernameElement.className =
        "post-username";

    usernameElement.textContent =
        username.toLowerCase();


    const timeElement =
        document.createElement("div");

    timeElement.className =
        "post-time";

    timeElement.textContent =
        formatTime(data.timestamp);


    userInfo.appendChild(usernameElement);
    userInfo.appendChild(timeElement);


    userRow.appendChild(avatar);
    userRow.appendChild(userInfo);


    /* POST IMAGE */

    let image = null;

    if (data.postImg) {

        image =
            document.createElement("img");

        image.className =
            "post-main-img";

        image.src =
            data.postImg;

        image.alt =
            "Post";

        image.loading =
            "lazy";

        image.onerror = () => {

            image.remove();

        };

    }


    /* ACTIONS */

    const actions =
        document.createElement("div");

    actions.className =
        "post-actions";


    /* LIKE */

    const likeButton =
        createActionButton(
            "heart",
            "Like"
        );

    likeButton.addEventListener(
        "click",
        () => {

            likeButton.classList.toggle(
                "liked"
            );

        }
    );


    /* COMMENT */

    const commentButton =
        createActionButton(
            "message-square",
            "Comment"
        );

    commentButton.addEventListener(
        "click",
        () => {

            alert(
                "Comments will be connected next."
            );

        }
    );


    /* SHARE */

    const shareButton =
        createActionButton(
            "send",
            "Share"
        );

    shareButton.addEventListener(
        "click",
        async () => {

            if (
                navigator.share
            ) {

                try {

                    await navigator.share({
                        title: "CodeChat",
                        text: `Post by ${username}`
                    });

                } catch (error) {

                    // User cancelled share.

                }

            } else {

                alert(
                    "Sharing will be connected next."
                );

            }

        }
    );


    /* SAVE */

    const saveButton =
        createActionButton(
            "bookmark",
            "Save"
        );

    saveButton.className +=
        " save-btn";

    saveButton.addEventListener(
        "click",
        () => {

            saveButton.classList.toggle(
                "liked"
            );

        }
    );


    actions.appendChild(
        likeButton
    );

    actions.appendChild(
        commentButton
    );

    actions.appendChild(
        shareButton
    );

    actions.appendChild(
        saveButton
    );


    /* INFO */

    const infoBox =
        document.createElement("div");

    infoBox.className =
        "post-info-box";


    const likes =
        document.createElement("div");

    likes.className =
        "likes-count";

    likes.textContent =
        `${Number(data.likes) || 0} likes`;


    const caption =
        document.createElement("div");

    caption.className =
        "post-caption";


    const captionUser =
        document.createElement("span");

    captionUser.className =
        "caption-username";

    captionUser.textContent =
        username.toLowerCase();


    caption.appendChild(
        captionUser
    );


    if (data.caption) {

        const captionText =
            document.createTextNode(
                data.caption
            );

        caption.appendChild(
            captionText
        );

    }


    infoBox.appendChild(
        likes
    );

    infoBox.appendChild(
        caption
    );


    /* BUILD */

    card.appendChild(
        userRow
    );

    if (image) {

        card.appendChild(
            image
        );

    }

    card.appendChild(
        actions
    );

    card.appendChild(
        infoBox
    );


    return card;
}


/* =========================
   ACTION BUTTON
========================= */

function createActionButton(
    iconName,
    label
) {

    const button =
        document.createElement("button");

    button.className =
        "action-btn";

    button.setAttribute(
        "aria-label",
        label
    );

    const icon =
        document.createElement("i");

    icon.setAttribute(
        "data-lucide",
        iconName
    );

    button.appendChild(
        icon
    );

    return button;
}


/* =========================
   TIME FORMAT
========================= */

function formatTime(timestamp) {

    if (!timestamp) {
        return "";
    }

    let date;

    if (
        typeof timestamp.toDate ===
        "function"
    ) {

        date =
            timestamp.toDate();

    } else if (
        timestamp instanceof Date
    ) {

        date =
            timestamp;

    } else {

        date =
            new Date(timestamp);

    }


    if (
        Number.isNaN(
            date.getTime()
        )
    ) {

        return "";

    }


    const now =
        new Date();

    const seconds =
        Math.floor(
            (now - date) / 1000
        );


    if (seconds < 60) {

        return "Just now";

    }

    if (seconds < 3600) {

        return `${Math.floor(
            seconds / 60
        )}m`;

    }

    if (seconds < 86400) {

        return `${Math.floor(
            seconds / 3600
        )}h`;

    }

    if (seconds < 604800) {

        return `${Math.floor(
            seconds / 86400
        )}d`;

    }


    return date.toLocaleDateString(
        undefined,
        {
            day: "numeric",
            month: "short"
        }
    );
}


/* =========================
   EMPTY STATE
========================= */

function showEmptyFeed() {

    feedBox.innerHTML = "";

    const box =
        document.createElement("div");

    box.className =
        "state-box";


    const icon =
        document.createElement("i");

    icon.setAttribute(
        "data-lucide",
        "image"
    );


    const title =
        document.createElement("div");

    title.className =
        "state-title";

    title.textContent =
        "No posts yet";


    const text =
        document.createElement("div");

    text.className =
        "state-text";

    text.textContent =
        "Be the first person to share something on CodeChat.";


    box.appendChild(icon);
    box.appendChild(title);
    box.appendChild(text);

    feedBox.appendChild(box);

    lucide.createIcons();
}


/* =========================
   ERROR STATE
========================= */

function showFeedError() {

    feedBox.innerHTML = "";

    const box =
        document.createElement("div");

    box.className =
        "state-box";


    const icon =
        document.createElement("i");

    icon.setAttribute(
        "data-lucide",
        "wifi-off"
    );


    const title =
        document.createElement("div");

    title.className =
        "state-title";

    title.textContent =
        "Couldn't load the feed";


    const text =
        document.createElement("div");

    text.className =
        "state-text";

    text.textContent =
        "Check your internet connection or Firebase rules and try again.";


    box.appendChild(icon);
    box.appendChild(title);
    box.appendChild(text);

    feedBox.appendChild(box);

    lucide.createIcons();
}

</script>

</body>
</html>
